<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>ShopList</title>
  <link rel="stylesheet" href="/css/main.css">
  <style>*,*::before,*::after{box-sizing:border-box;}</style>
  <link rel="manifest" href="/manifest.json?v=<%= locals.version %>">
  <link rel="icon" type="image/svg+xml" href="/icon.svg">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="apple-touch-icon" href="/icon.svg">
  <meta name="theme-color" content="#3b82f6">
</head>
<body class="bg-gray-50 min-h-dvh">
  <div class="max-w-sm mx-auto px-4 py-6" style="padding-bottom:110px;">
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-800">ShopList</h1>
      <p class="text-gray-400 text-sm truncate"><span id="greetWord">Bonjour</span>, <%= user.pseudo %></p>
    </div>

    <% var todoCount = 0; lists.forEach(function(l) { todoCount += (l.item_count || 0) - (l.checked_count || 0); }); %>
    <div class="flex gap-2 mb-4">
      <div class="flex-1 bg-white rounded-2xl shadow-sm border border-gray-100 p-4 text-center">
        <p id="statLists" class="text-2xl font-bold text-gray-800"><%= lists.length %></p>
        <p class="text-xs text-gray-400 mt-1">liste<%= lists.length > 1 ? 's' : '' %></p>
      </div>
      <div class="flex-1 bg-white rounded-2xl shadow-sm border border-gray-100 p-4 text-center">
        <p id="statTodo" class="text-2xl font-bold text-gray-800"><%= todoCount %></p>
        <p class="text-xs text-gray-400 mt-1">article<%= todoCount > 1 ? 's' : '' %> à acheter</p>
      </div>
    </div>

    <a href="/listes" style="min-height:48px;"
      class="w-full bg-blue-500 text-white font-medium py-3 rounded-xl text-sm hover:bg-blue-600 active:bg-blue-700 transition-colors flex items-center justify-center gap-2 mb-4">
      Voir mes listes
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </a>

    <a href="/listes" style="min-height:48px;"
      class="w-full bg-green-500 text-white font-medium py-3 rounded-xl text-sm hover:bg-green-600 active:bg-green-700 transition-colors flex items-center justify-center gap-2 mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
      Créer une nouvelle liste
    </a>

    <% function fmtD(s) { try { var d = new Date(String(s || '').replace(' ', 'T') + 'Z'); if (isNaN(d.getTime())) return ''; var p = function(n) { return String(n).padStart(2, '0'); }; return p(d.getDate()) + '/' + p(d.getMonth() + 1) + '/' + d.getFullYear(); } catch (e) { return ''; } } %>
    <% if (recent.length) { %>
      <div id="recentSection" class="mt-6">
        <p class="text-sm font-bold text-gray-800 mb-2">Listes récentes</p>
        <div id="recentLists" class="space-y-2">
          <% recent.forEach(function(l) { %>
            <% var pct = l.item_count ? Math.round(100 * (l.checked_count || 0) / l.item_count) : 0; %>
            <% var isDone = (l.item_count || 0) > 0 && (l.checked_count || 0) === l.item_count && l.can_edit; %>
            <a href="/list/<%= l.id %>" class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 flex items-center gap-3">
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-800 truncate"><%= l.name %> <span class="text-xs font-normal text-gray-400">• Créé le <%= fmtD(l.created_at) %></span></p>
                <div class="h-2 bg-gray-100 rounded-full mt-2 overflow-hidden"><div class="h-full bg-blue-500 rounded-full" style="width:<%= pct %>%;background:<%= isDone ? '#22c55e' : '#3b82f6' %>;"></div></div>
                <p class="text-xs text-gray-400 mt-1"><%= (l.checked_count || 0) %>/<%= (l.item_count || 0) %> articles</p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:<%= isDone ? '#22c55e' : '#d1d5db' %>;">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          <% }); %>
        </div>
      </div>
    <% } %>
    <% if (!lists.length) { %>
      <div id="homeEmpty" class="mt-6 border-2 border-dashed border-gray-200 rounded-2xl p-6 text-center">
        <p class="text-sm font-medium text-gray-800">Aucune liste pour l'instant</p>
        <p class="text-xs text-gray-400 mt-1 mb-3">Crée ta première liste pour commencer tes courses</p>
        <a href="/listes" class="inline-block bg-blue-500 text-white font-medium px-5 py-2.5 rounded-xl text-sm">Créer ma première liste</a>
      </div>
    <% } %>
  </div>
  <%- include('partials/install-banner') %>
  <script>
    (function() {
      var h = new Date().getHours();
      var gw = document.getElementById('greetWord');
      if (gw) gw.textContent = (h >= 18 || h < 5) ? 'Bonsoir' : 'Bonjour';
      function esc(s) {
        return String(s == null ? '' : s).replace(/[&<>"']/g, function(c) {
          return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
        });
      }
      function fmtD(s) {
        try {
          var d = new Date(String(s || '').replace(' ', 'T') + 'Z');
          if (isNaN(d.getTime())) return '';
          var p = function(n) { return String(n).padStart(2, '0'); };
          return p(d.getDate()) + '/' + p(d.getMonth() + 1) + '/' + d.getFullYear();
        } catch (e) { return ''; }
      }
      function recentCard(l) {
        var done = l.checked_count || 0, total = l.item_count || 0;
        var pct = total ? Math.round(100 * done / total) : 0;
        var color = (total > 0 && done === total && l.can_edit) ? '#22c55e' : '#d1d5db';
        return '<a href="/list/' + l.id + '" class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 flex items-center gap-3">'
          + '<div class="flex-1 min-w-0">'
          + '<p class="text-sm font-medium text-gray-800 truncate">' + esc(l.name) + ' <span class="text-xs font-normal text-gray-400">• Cr\u00e9\u00e9 le ' + fmtD(l.created_at) + '</span></p>'
          + '<div class="h-2 bg-gray-100 rounded-full mt-2 overflow-hidden"><div class="h-full bg-blue-500 rounded-full" style="width:' + pct + '%;background:' + (total > 0 && done === total ? '#22c55e' : '#3b82f6') + ';"></div></div>'
          + '<p class="text-xs text-gray-400 mt-1">' + done + '/' + total + ' articles</p>'
          + '</div>'
          + '<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="color:' + color + ';">'
          + '<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg></a>';
      }
      async function refreshStats() {
        try {
          const res = await fetch('/api/lists');
          if (!res.ok) return;
          const lists = await res.json();
          var todo = 0;
          lists.forEach(function(l) { todo += (l.item_count || 0) - (l.checked_count || 0); });
          document.getElementById('statLists').textContent = lists.length;
          document.getElementById('statTodo').textContent = todo;
          var he = document.getElementById('homeEmpty');
          if (he) he.style.display = lists.length ? 'none' : '';
          var sec = document.getElementById('recentSection');
          var box = document.getElementById('recentLists');
          if (sec && box) {
            var top = lists.slice(0, 3);
            if (!top.length) sec.style.display = 'none';
            else { sec.style.display = ''; box.innerHTML = top.map(recentCard).join(''); }
          }
        } catch {}
      }
      refreshStats();
    })();
  </script>
  <%- include('partials/bottom-nav', {active: 'home'}) %>
  <script src="/js/app-version.js?v=<%= locals.version %>" defer></script>
</body>
</html>

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Membres - <%= list.name %> - ShopList</title>
  <link rel="stylesheet" href="/css/main.css">
  <style>*,*::before,*::after{box-sizing:border-box;}</style>
  <link rel="manifest" href="/manifest.json?v=<%= locals.version %>">
  <link rel="icon" type="image/svg+xml" href="/icon.svg">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="apple-touch-icon" href="/icon.svg">
  <meta name="theme-color" content="#3b82f6">
</head>
<body class="bg-gray-50 min-h-dvh">
  <div class="max-w-sm mx-auto px-4 py-6" style="padding-bottom:110px;">
    <div class="flex items-center gap-3 mb-6">
      <a href="/list/<%= list.id %>" class="shrink-0 text-gray-400 hover:text-gray-600 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
      <h1 class="text-xl font-bold text-gray-800 truncate"><%= list.name %></h1>
    </div>

    <% if (canInvite) { %>
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 mb-6">
      <h2 class="text-sm font-semibold text-gray-700 mb-1">Partager la liste</h2>
      <p class="text-xs text-gray-400 mb-3">Lien valide 30 min, usage unique.</p>
      <div id="shareBox">
        <% if (inviteUrl) { %>
          <div class="flex gap-2">
            <input type="text" id="shareLink" readonly value="<%= inviteUrl %>"
              class="flex-1 min-w-0 px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-xs text-gray-500 focus:outline-none">
            <button onclick="copyLink()" id="copyBtn"
              class="shrink-0 bg-blue-500 text-white font-medium px-4 rounded-xl text-sm hover:bg-blue-600 active:bg-blue-700 transition-colors">
              Copier
            </button>
          </div>
        <% } else { %>
          <button onclick="genLink()" id="genBtn"
            class="w-full bg-blue-500 text-white font-medium py-2.5 rounded-xl text-sm hover:bg-blue-600 active:bg-blue-700 transition-colors">
            Générer un lien
          </button>
        <% } %>
      </div>
    </div>
    <% } %>

    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4">
      <h2 id="membersTitle" class="text-sm font-semibold text-gray-700 mb-3">Membres (<%= members.length %>)</h2>
      <div id="membersList" class="space-y-3">
        <% members.forEach(m => { %>
          <% const initial = (m.pseudo || m.email || '?').trim().charAt(0).toUpperCase(); %>
          <% const isMe = locals.user && m.email === user.email; %>
          <div class="flex items-center gap-3" data-email="<%= m.email %>">
            <span class="shrink-0 flex items-center justify-center font-semibold text-sm" style="width:40px;height:40px;border-radius:9999px;background:#dbeafe;color:#1d4ed8;"><%= initial %></span>
            <div class="min-w-0 flex-1">
              <p class="text-sm text-gray-800 font-medium truncate"><%= m.pseudo || m.email %><% if (isMe) { %> <span class="text-xs font-normal px-2 py-0.5 rounded-full" style="background:#dbeafe;color:#1d4ed8;">Toi</span><% } %></p>
              <p class="text-xs text-gray-400 truncate"><%= m.email %></p>
            </div>
            <% if (m.email === list.created_by) { %>
              <span class="text-xs font-medium px-2 py-0.5 rounded-full shrink-0 ml-2" style="background:#fef3c7;color:#92400e;">Proprietaire</span>
            <% } else { %>
              <% if (!m.canEdit) { %><span class="text-xs font-medium px-2 py-0.5 rounded-full shrink-0 ml-2" style="background:#f3f4f6;color:#6b7280;">Lecteur</span><% } %>
              <% if (locals.user && list.created_by === user.email) { %>
              <button onclick="removeMember('<%= m.email %>')" class="text-red-400 hover:text-red-600 text-sm font-medium shrink-0 ml-2">Retirer</button>
              <% } %>
            <% } %>
          </div>
        <% }) %>
      </div>
    </div>
  </div>

  <div id="confirmOverlay" class="hidden fixed inset-0 z-50 bg-black/40 flex items-center justify-center px-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-xs p-6">
      <p id="confirmMsg" class="text-gray-800 text-sm font-medium text-center mb-5"></p>
      <div class="flex gap-3">
        <button id="confirmNo" class="flex-1 py-2.5 rounded-xl text-sm font-medium border border-gray-200 text-gray-500 hover:bg-gray-50 transition-colors">Annuler</button>
        <button id="confirmYes" class="flex-1 py-2.5 rounded-xl text-sm font-medium bg-red-500 text-white hover:bg-red-600 transition-colors">Confirmer</button>
      </div>
    </div>
  </div>

  <script>
    var listId = '<%= list.id %>';

    function showConfirm(msg) {
      return new Promise(resolve => {
        document.getElementById('confirmMsg').textContent = msg;
        document.getElementById('confirmOverlay').classList.remove('hidden');
        document.getElementById('confirmYes').onclick = () => { document.getElementById('confirmOverlay').classList.add('hidden'); resolve(true); };
        document.getElementById('confirmNo').onclick = () => { document.getElementById('confirmOverlay').classList.add('hidden'); resolve(false); };
      });
    }

    async function genLink() {
      const res = await fetch('/api/list/' + listId + '/invite', { method: 'POST' });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.token) return;
      const box = document.getElementById('shareBox');
      box.innerHTML = '<div class="flex gap-2">'
        + '<input type="text" id="shareLink" readonly value="' + window.location.origin + '/join/' + data.token + '"'
        + ' class="flex-1 min-w-0 px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-xs text-gray-500 focus:outline-none">'
        + '<button onclick="copyLink()" id="copyBtn"'
        + ' class="shrink-0 bg-blue-500 text-white font-medium px-4 rounded-xl text-sm hover:bg-blue-600 active:bg-blue-700 transition-colors">Copier</button>'
        + '</div>';
    }

    async function copyLink() {
      const input = document.getElementById('shareLink');
      const btn = document.getElementById('copyBtn');
      try {
        if (navigator.clipboard) await navigator.clipboard.writeText(input.value);
        else { input.select(); document.execCommand('copy'); }
      } catch { input.select(); document.execCommand('copy'); }
      btn.textContent = 'Copié !';
      setTimeout(() => { btn.textContent = 'Copier'; }, 2000);
    }

    async function removeMember(email) {
      const ok = await showConfirm('Retirer ' + email + ' de cette liste ?');
      if (!ok) return;
      const res = await fetch('/api/list/' + listId + '/members/' + encodeURIComponent(email), { method: 'DELETE' });
      if (!res.ok) return;
      const row = document.querySelector('[data-email="' + CSS.escape(email) + '"]');
      if (row) row.remove();
      const left = document.querySelectorAll('#membersList [data-email]').length;
      document.getElementById('membersTitle').textContent = 'Membres (' + left + ')';
    }
  </script>
  <%- include('partials/bottom-nav', {active: 'listes'}) %>
  <script src="/js/app-version.js?v=<%= locals.version %>" defer></script>
</body>
</html>

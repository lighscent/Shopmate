<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title><%= list.name %> - ShopList</title>
  <link rel="stylesheet" href="/css/main.css">
  <style>*,*::before,*::after{box-sizing:border-box;}</style>
  <link rel="manifest" href="/manifest.json?v=<%= locals.version %>">
  <link rel="icon" type="image/svg+xml" href="/icon.svg">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <link rel="apple-touch-icon" href="/icon.svg">
  <meta name="theme-color" content="#3b82f6">
</head>
<body class="bg-gray-50 min-h-dvh">
  <div class="max-w-sm mx-auto px-4 py-6" style="padding-bottom:110px;">
    <div class="flex items-center gap-2 mb-4" style="position:sticky;top:0;z-index:30;background:#f9fafb;padding:12px 0;">
      <a href="/listes" aria-label="Retour" class="shrink-0 text-gray-400 hover:text-gray-600 transition-colors p-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </a>
      <div class="min-w-0 flex-1">
          <h1 class="text-2xl font-bold text-gray-800 truncate"><%= list.name %></h1>
          <p class="text-xs text-gray-400 mt-1" id="updatedDate">
          <% 
            const d = new Date(list.updated_at + 'Z');
            const pad = n => String(n).padStart(2, '0');
            const formatted = pad(d.getDate()) + '/' + pad(d.getMonth()+1) + '/' + d.getFullYear() + ' à ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
          %>
          Modifiée le <%= formatted %>
        </p>
      </div>
      <% if (canEdit) { %>
        <button type="button" id="renameBtn" title="Renommer" aria-label="Renommer"
          class="shrink-0 text-gray-400 hover:text-gray-600 transition-colors p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" />
          </svg>
        </button>
      <% } %>
      <a href="/list/<%= list.id %>/members" title="Membres" aria-label="Membres"
        class="shrink-0 text-gray-400 hover:text-gray-600 transition-colors p-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
        </svg>
      </a>
    </div>

    <% if (!canEdit) { %>
      <p class="text-xs text-center font-medium mb-4 px-3 py-2 rounded-xl" style="background:#f3f4f6;color:#6b7280;">Lecture seule — tu peux voir mais pas modifier</p>
    <% } %>

    <div class="mb-6">
      <% const total0 = list.items.length; const done0 = list.items.filter(i => i.checked).length; const pct0 = total0 > 0 ? Math.round(done0 / total0 * 100) : 0; %>
      <p id="progressText" class="text-xs text-gray-400 mb-1.5"><% if (total0 > 0) { %><%= done0 %> / <%= total0 %> sélectionnés (<%= pct0 %> %)<% } %></p>
      <div class="rounded-full" style="height:8px;background:#e5e7eb;">
        <div id="progressBar" class="rounded-full transition-all" style="height:8px;width:<%= pct0 %>%;background:#3b82f6;"></div>
      </div>
    </div>

    <% var currentSort = locals.sort || 'created'; %>
    <div class="flex gap-2 mb-4">
      <a href="/list/<%= list.id %>"
        class="flex-1 text-center text-xs font-medium py-2 rounded-xl transition-colors <%= currentSort === 'created' ? 'bg-blue-500 text-white' : 'bg-white text-gray-500 border border-gray-200' %>">
        Tri : création
      </a>
      <a href="/list/<%= list.id %>?sort=updated"
        class="flex-1 text-center text-xs font-medium py-2 rounded-xl transition-colors <%= currentSort === 'updated' ? 'bg-blue-500 text-white' : 'bg-white text-gray-500 border border-gray-200' %>">
        Tri : modification
      </a>
    </div>

    <% if (canEdit) { %>
    <div style="position:relative;">
    <form id="addForm" class="flex gap-2 mb-6">
      <input type="number" name="quantity" min="1" value="1"
        class="px-3 bg-white border border-gray-200 rounded-xl text-sm text-center focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent shrink-0" style="width:56px;height:48px;">
      <input type="text" name="name" placeholder="Ajouter un article..." required
        class="flex-1 min-w-0 px-4 bg-white border border-gray-200 rounded-xl text-sm shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" style="height:48px;">
      <button type="submit" title="Ajouter" aria-label="Ajouter"
        style="width:48px;height:48px;"
        class="shrink-0 bg-blue-500 text-white rounded-xl hover:bg-blue-600 active:bg-blue-700 transition-colors flex items-center justify-center shadow-sm">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
      </button>
    </form>
    <div id="suggBox" class="hidden" style="position:absolute;top:100%;left:0;right:0;z-index:30;background:#fff;border:1px solid #e5e7eb;border-radius:12px;box-shadow:0 10px 25px rgba(0,0,0,.12);margin-top:2px;overflow:hidden;"></div>
    </div>
    <% } %>

    <div id="itemsList" class="space-y-2">
      <% const sorted = [...list.items].sort((a, b) => (a.checked ? 1 : 0) - (b.checked ? 1 : 0)); %>
      <% if (sorted.length === 0) { %>
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 text-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-gray-300 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z" />
          </svg>
          <p class="text-gray-800 font-medium text-sm mb-1">Liste vide</p>
          <p class="text-gray-400 text-xs"><% if (canEdit) { %>Ajoute ton premier article ci-dessus<% } else { %>Rien à afficher pour l'instant<% } %></p>
        </div>
      <% } %>
      <% sorted.forEach(item => { %>
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-3 flex items-center gap-2 transition-opacity <%= item.checked ? 'opacity-50' : '' %>" data-id="<%= item.id %>">
          <input type="checkbox" <%= item.checked ? 'checked' : '' %> <%= canEdit ? '' : 'disabled' %>
            onchange="toggleItem('<%= item.id %>')"
            class="rounded border-gray-300 text-blue-500 focus:ring-blue-500 shrink-0" style="width:24px;height:24px;">
          <div class="flex-1 min-w-0">
            <p class="<%= item.checked ? 'line-through text-gray-400' : 'text-gray-800' %> font-medium text-sm truncate">
              <%= item.name %><% if (item.quantity > 1) { %> <span class="text-xs font-normal text-gray-400">× <%= item.quantity %></span><% } %>
            </p>
            <p class="text-xs text-gray-400 mt-0.5">
              <%= item.addedBy %>
            </p>
          </div>
          <% if (canEdit) { %>
          <div class="flex items-center gap-1 shrink-0">
            <button onclick="changeQty('<%= item.id %>', -1)" aria-label="Moins"
              class="rounded-full bg-red-100 text-red-500 hover:bg-red-200 flex items-center justify-center text-base font-bold transition-colors" style="width:36px;height:36px;">−</button>
            <span class="item-qty text-center text-sm font-medium text-gray-700" style="min-width:24px;"><%= item.quantity %></span>
            <button onclick="changeQty('<%= item.id %>', 1)" aria-label="Plus"
              class="rounded-full bg-green-100 text-green-500 hover:bg-green-200 flex items-center justify-center text-base font-bold transition-colors" style="width:36px;height:36px;">+</button>
            <button onclick="deleteItem('<%= item.id %>')" aria-label="Supprimer"
              class="text-red-300 hover:text-red-500 transition-colors p-2 ml-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
          <% } %>
        </div>
      <% }) %>
    </div>
    <% if (canEdit) { %>
    <div class="mt-4 text-center">
      <button id="clearCheckedBtn" onclick="clearChecked()" class="<%= list.items.some(i => i.checked) ? '' : 'hidden ' %>text-xs text-gray-400 hover:text-red-500 font-medium transition-colors">
        Supprimer les articles sélectionnées
      </button>
    </div>
    <% } %>
    <% if (locals.user && list.created_by === user.email) { %>
      <div class="mt-8 pt-6 border-t border-gray-200">
        <button onclick="deleteList()"
          class="w-full text-red-400 hover:text-red-600 text-sm font-medium py-2.5 rounded-xl border border-red-200 hover:border-red-300 transition-colors">
          Supprimer cette liste
        </button>
      </div>
    <% } %>

  </div>

  <div id="toast" class="hidden fixed top-4 left-1/2 -translate-x-1/2 z-50 bg-gray-800 text-white px-4 py-3 rounded-xl text-sm shadow-lg max-w-xs text-center"></div>

  <div id="confirmOverlay" class="hidden fixed inset-0 z-50 bg-black/40 flex items-center justify-center px-4">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-xs p-6">
      <p id="confirmMsg" class="text-gray-800 text-sm font-medium text-center mb-5"></p>
      <div class="flex gap-3">
        <button id="confirmNo" class="flex-1 py-2.5 rounded-xl text-sm font-medium border border-gray-200 text-gray-500 hover:bg-gray-50 transition-colors">Annuler</button>
        <button id="confirmYes" class="flex-1 py-2.5 rounded-xl text-sm font-medium bg-red-500 text-white hover:bg-red-600 transition-colors">Confirmer</button>
      </div>
    </div>
  </div>

  <script>
    var listId = '<%= list.id %>';
    var CAN_EDIT = <%= canEdit ? 'true' : 'false' %>;
    var userPseudo = '<%= locals.user && user.pseudo ? user.pseudo.replace(/'/g, "\\'") : "" %>';
    var defaultName = userPseudo || 'Anonyme';
    var ws = null, wsRetry = 0, wsTimer = null, wsDead = false, refreshTimer = null;
    window.__pageCleanup = window.__pageCleanup || [];
    window.__pageCleanup.push(function() {
      wsDead = true;
      if (wsTimer) { clearTimeout(wsTimer); wsTimer = null; }
      if (refreshTimer) { clearInterval(refreshTimer); refreshTimer = null; }
      try { if (ws) { ws.onclose = function() {}; ws.close(); } } catch (e) {}
    });
    function connectWs() {
      ws = new WebSocket((window.location.protocol === 'https:' ? 'wss:' : 'ws:') + '//' + window.location.host);
      ws.onopen = () => { wsRetry = 0; ws.send(JSON.stringify({ action: 'join', listId })); refreshList(); };
      ws.onmessage = (e) => { try {
        const d = JSON.parse(e.data);
        if (d.type === 'list-deleted') { if (window.goPage) window.goPage('/listes'); else window.location.href = '/listes'; return; }
        if (d.type === 'update') refreshList();
        if (d.type === 'item-added' && d.item && d.item.addedBy !== defaultName) { showToast(d.item.addedBy + ' a ajoute ' + d.item.name); refreshList(); }
      } catch {} };
      ws.onclose = () => { if (wsDead) return; wsRetry++; wsTimer = setTimeout(connectWs, Math.min(1000 * Math.pow(2, wsRetry), 15000)); };
      ws.onerror = () => { try { ws.close(); } catch {} };
    }
    connectWs();
    (function() {
      var btn = document.getElementById('renameBtn');
      if (!btn || !CAN_EDIT) return;
      var h1 = btn.closest('.flex').querySelector('h1');
      btn.addEventListener('click', function() {
        if (document.getElementById('renameInput')) return;
        var old = h1.textContent;
        var input = document.createElement('input');
        input.id = 'renameInput';
        input.type = 'text';
        input.value = old;
        input.maxLength = 60;
        input.className = 'w-full px-2 py-1 border border-blue-500 rounded-lg text-2xl font-bold text-gray-800 focus:outline-none';
        h1.replaceWith(input);
        input.focus();
        input.select();
        var done = false;
        async function save() {
          if (done) return; done = true;
          var name = input.value.trim();
          if (!name || name === old) { input.replaceWith(h1); return; }
          try {
            const res = await fetch('/api/list/' + listId + '/rename', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ name })
            });
            const data = await res.json().catch(() => ({}));
            if (res.ok && data.name) {
              h1.textContent = data.name;
              document.title = data.name + ' - ShopList';
              try { if (window.__spaForget) window.__spaForget('/'); } catch (e) {}
            }
          } catch {}
          input.replaceWith(h1);
        }
        function cancel() { done = true; input.replaceWith(h1); }
        input.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') save();
          else if (e.key === 'Escape') cancel();
        });
        input.addEventListener('blur', save);
      });
    })();
    function fmtDate(iso) {
      const d = new Date(iso + 'Z');
      const pad = n => String(n).padStart(2, '0');
      return pad(d.getDate()) + '/' + pad(d.getMonth()+1) + '/' + d.getFullYear() + ' à ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    }

    var addFormEl = document.getElementById('addForm');
    if (addFormEl) addFormEl.addEventListener('submit', async function(e) {
      e.preventDefault();
      const name = this.querySelector('[name="name"]').value.trim();
      const qty = parseInt(this.querySelector('[name="quantity"]').value, 10) || 1;
      if (!name) return;
      await fetch('/api/list/' + listId + '/items', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, quantity: qty, addedBy: defaultName })
      });

      this.querySelector('[name="name"]').value = '';
      this.querySelector('[name="quantity"]').value = '1';
      var sb = document.getElementById('suggBox');
      if (sb) sb.classList.add('hidden');
      refreshList();
    });

    // Autocomplete depuis le catalogue perso (min 2 lettres)
    var suggInput = addFormEl ? addFormEl.querySelector('[name="name"]') : null;
    var suggBox = document.getElementById('suggBox');
    var suggTimer = null;
    if (suggInput && suggBox) {
      suggInput.setAttribute('autocomplete', 'off');
      suggInput.addEventListener('input', function() {
        if (suggTimer) clearTimeout(suggTimer);
        var q = suggInput.value.trim();
        if (q.length < 2) { suggBox.classList.add('hidden'); return; }
        suggTimer = setTimeout(function() {
          fetch('/api/catalog?q=' + encodeURIComponent(suggInput.value.trim()), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function(r) { return r.ok ? r.json() : []; })
            .then(function(arr) {
              if (!arr.length || document.activeElement !== suggInput) { suggBox.classList.add('hidden'); return; }
              suggBox.innerHTML = '';
              arr.forEach(function(a) {
                var b = document.createElement('button');
                b.type = 'button';
                b.style.cssText = 'display:flex;width:100%;align-items:center;gap:8px;padding:10px 12px;font-size:14px;color:#1f2937;background:#fff;border:0;border-bottom:1px solid #f3f4f6;text-align:left;';
                b.textContent = a.name + (a.price != null ? ' — ' + a.price + ' €' : '');
                b.addEventListener('mousedown', function(e) { e.preventDefault(); suggInput.value = a.name; suggBox.classList.add('hidden'); });
                suggBox.appendChild(b);
              });
              suggBox.classList.remove('hidden');
            }).catch(function() {});
        }, 200);
      });
      suggInput.addEventListener('blur', function() { setTimeout(function() { suggBox.classList.add('hidden'); }, 150); });
    }

    async function toggleItem(itemId) {
      await fetch('/api/list/' + listId + '/items/' + itemId + '/toggle', { method: 'POST' });
      refreshList();
    }

    function showToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.remove('hidden');
      setTimeout(() => t.classList.add('hidden'), 3000);
    }

    function showConfirm(msg) {
      return new Promise(resolve => {
        document.getElementById('confirmMsg').textContent = msg;
        document.getElementById('confirmOverlay').classList.remove('hidden');
        document.getElementById('confirmYes').onclick = () => { document.getElementById('confirmOverlay').classList.add('hidden'); resolve(true); };
        document.getElementById('confirmNo').onclick = () => { document.getElementById('confirmOverlay').classList.add('hidden'); resolve(false); };
      });
    }

    async function deleteItem(itemId) {
      const ok = await showConfirm('Supprimer cet article ?');
      if (!ok) return;
      await fetch('/api/list/' + listId + '/items/' + itemId, { method: 'DELETE' });
      refreshList();
    }

    async function changeQty(itemId, delta) {
      if (delta === -1) {
        const itemDiv = document.querySelector(`[data-id="${itemId}"]`);
        const currentQty = parseInt(itemDiv?.querySelector('.item-qty')?.textContent, 10);
        if (currentQty <= 1) {
          const ok = await showConfirm('Supprimer cet article ?');
          if (!ok) return;
          await fetch('/api/list/' + listId + '/items/' + itemId, { method: 'DELETE' });
          refreshList();
          return;
        }
      }
      await fetch('/api/list/' + listId + '/items/' + itemId + '/quantity', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ delta })
      });
      refreshList();
    }

    async function refreshList() {
      if (window.__spaForget) window.__spaForget(window.location.pathname);
      const res = await fetch('/api/list/' + listId + window.location.search);
      const data = await res.json();
      renderItems(data.items);
      document.getElementById('updatedDate').textContent = 'Modifiée le ' + fmtDate(data.updated_at);
    }

    function updateProgress(items) {
      const total = items.length;
      const done = items.filter(i => i.checked).length;
      const pct = total > 0 ? Math.round(done / total * 100) : 0;
      document.getElementById('progressText').textContent = total === 0 ? '' : done + ' / ' + total + ' sélectionnés (' + pct + ' %)';
      document.getElementById('progressBar').style.width = pct + '%';
      const ccBtn = document.getElementById('clearCheckedBtn');
      if (ccBtn) ccBtn.classList.toggle('hidden', done === 0);
    }

    async function clearChecked() {
      const ok = await showConfirm('Supprimer tous les articles sélectionnés ?');
      if (!ok) return;
      await fetch('/api/list/' + listId + '/checked', { method: 'DELETE' });
      refreshList();
    }

    function renderItems(items) {
      const container = document.getElementById('itemsList');
      updateProgress(items);
      if (items.length === 0) {
        container.innerHTML = `<div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 text-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-gray-300 mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z" />
          </svg>
          <p class="text-gray-800 font-medium text-sm mb-1">Liste vide</p>
          <p class="text-gray-400 text-xs">${CAN_EDIT ? 'Ajoute ton premier article ci-dessus' : "Rien à afficher pour l'instant"}</p>
        </div>`;
        return;
      }
      container.innerHTML = [...items].sort((a, b) => (a.checked ? 1 : 0) - (b.checked ? 1 : 0)).map(item => `
        <div data-id="${item.id}" class="bg-white rounded-xl shadow-sm border border-gray-100 p-3 flex items-center gap-2 transition-opacity ${item.checked ? 'opacity-50' : ''}">
          <input type="checkbox" ${item.checked ? 'checked' : ''} ${CAN_EDIT ? '' : 'disabled'}
            onchange="toggleItem('${item.id}')"
            class="rounded border-gray-300 text-blue-500 focus:ring-blue-500 shrink-0" style="width:24px;height:24px;">
          <div class="flex-1 min-w-0">
            <p class="${item.checked ? 'line-through text-gray-400' : 'text-gray-800'} font-medium text-sm truncate">${esc(item.name)}${item.quantity > 1 ? ' <span class="text-xs font-normal text-gray-400">× ' + item.quantity + '</span>' : ''}</p>
            <p class="text-xs text-gray-400 mt-0.5">${esc(item.addedBy)}</p>
          </div>
          <div class="${CAN_EDIT ? 'flex items-center gap-1 shrink-0' : 'hidden'}">
            <button onclick="changeQty('${item.id}', -1)" aria-label="Moins"
              class="rounded-full bg-red-100 text-red-500 hover:bg-red-200 flex items-center justify-center text-base font-bold transition-colors" style="width:36px;height:36px;">−</button>
            <span class="item-qty text-center text-sm font-medium text-gray-700" style="min-width:24px;">${item.quantity}</span>
            <button onclick="changeQty('${item.id}', 1)" aria-label="Plus"
              class="rounded-full bg-green-100 text-green-500 hover:bg-green-200 flex items-center justify-center text-base font-bold transition-colors" style="width:36px;height:36px;">+</button>
            <button onclick="deleteItem('${item.id}')" aria-label="Supprimer"
              class="text-red-300 hover:text-red-500 transition-colors p-2 ml-1">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>
      `).join('');
    }

    function esc(str) {
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    async function deleteList() {
      const ok = await showConfirm('Supprimer cette liste definitivement ?');
      if (!ok) return;
      await fetch('/api/list/' + listId, { method: 'DELETE' });
      if (window.goPage) window.goPage('/listes'); else window.location.href = '/listes';
    }

    refreshTimer = setInterval(refreshList, 30000);
  </script>
  <%- include('partials/install-banner') %>
  <%- include('partials/calc-modal') %>
  <%- include('partials/bottom-nav', {active: 'listes'}) %>
  <script src="/js/app-version.js?v=<%= locals.version %>" defer></script>
</body>
</html>
